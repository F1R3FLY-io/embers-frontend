contract main(@input, return) = {
  new gpt4(`rho:ai:gpt4`) in {
    gpt4!("Critique the reasoning in the hypothesis. Identify contradictions, invalid inferences, and missing assumptions. Maximum 120 words." ++ "\nQuery: " ++ input.get("input") ++ "\nHypothesis: " ++ input.get("hypothesize"), *return)
  }
}
