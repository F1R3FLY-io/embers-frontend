contract main(@input, return) = {
  new gpt4(`rho:ai:gpt4`) in {
    gpt4!("Critique the practical feasibility of the hypothesis. Identify resource constraints, failure modes, and concrete mitigations. Maximum 120 words." ++ "\nQuery: " ++ input.get("input") ++ "\nHypothesis: " ++ input.get("hypothesize"), *return)
  }
}
