diff --git a/casper/tests/api/deploy_finalization_status_test.rs b/casper/tests/api/deploy_finalization_status_test.rs
index 015cae67e..9be2380f7 100644
--- a/casper/tests/api/deploy_finalization_status_test.rs
+++ b/casper/tests/api/deploy_finalization_status_test.rs
@@ -1565,3 +1565,89 @@ async fn resolve_returns_pending_for_non_canonical_clean_with_canonical_reject()
         "exactly one canonical rejection event in C",
