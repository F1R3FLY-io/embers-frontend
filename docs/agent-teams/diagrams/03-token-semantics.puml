@startuml
title Workflow token semantics — fan-out, guards, fan-in, and bounded feedback
skinparam backgroundColor #FFFBF6
skinparam shadowing false
skinparam ArrowColor #54413A
skinparam activity {
  BackgroundColor #FFF1DD
  BorderColor #A55B30
  DiamondBackgroundColor #D9ECFF
  DiamondBorderColor #3979A4
  StartColor #2E7D5B
  EndColor #7B3F8C
}

start
:Input token\n(value, context); <<#CDEACC>>
:Planner agent; <<#FFE0B2>>
if (firstMatch routes) then (priority 0)
  :Research branch; <<#D7EAF8>>
elseif (priority 1)
  :Critique branch; <<#E3D8F5>>
else (no match)
  :Fail / skip / complete; <<#F7C7C7>>
  stop
endif

fork
  :Text model; <<#D7EAF8>>
fork again
  :Policy check; <<#E3D8F5>>
end fork
:all / quorum / race join; <<#FFE0B2>>
:Synthesize output; <<#CDEACC>>
if (quality sufficient?) then (yes)
  :Terminal response; <<#BEE5CF>>
  stop
else (no)
  :Increment transition counter; <<#FFF0A8>>
  if (counter below bound?) then (yes)
    :Route back to Planner; <<#FFD0B5>>
  else (no)
    :iterationLimit disposition; <<#F7C7C7>>
    stop
  endif
endif

legend right
  Every token carries the original input,
  portable state, and per-transition counters.
  Persistent Rholang contracts permit revisits.
endlegend
@enduml
