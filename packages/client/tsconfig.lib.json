{
  "compilerOptions": {
    "tsBuildInfoFile": "./.tmp/tsconfig.lib.tsbuildinfo",
    "incremental": true,
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "typeRoots": ["./types", "./node_modules/@types"],
    // No "@" path mapping on purpose — see vite.config.ts. This package is
    // compiled from source by the app's Vite in dev, where "@" means the APP's
    // src. Keeping this unset makes a stray "@/" import fail to compile rather
    // than silently resolve to the wrong package.

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "noEmit": true,
    "noEmitOnError": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    // "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src", "types"]
}
